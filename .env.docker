# Template for the root .env that docker-compose.yml interpolates:
#   cp .env.docker .env
# Only variables docker-compose.yml actually reads belong here — compose
# passes nothing else into the containers. Laravel-only settings live in
# the laravel service's environment block.

# Application
APP_ENV=local
APP_DEBUG=true
# APP_KEY lives in backend/.env (gitignored); the entrypoint generates it on first boot.

# Database
DB_NAME=manuscript_tracker
DB_USER=postgres
DB_PASSWORD=postgres_dev_password

# Redis
REDIS_PASSWORD=redis_dev_password

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@manuscripttracker.local

# Front end: leave empty so the SPA calls relative /api on its own origin.
# VITE_API_URL=

# Host ports
NGINX_PORT=80
LARAVEL_PORT=9000
REACT_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025

# Database UIs
ADMINER_PORT=8081
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin_dev_password
REDIS_COMMANDER_PORT=8083
