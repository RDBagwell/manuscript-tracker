# syntax=docker/dockerfile:1.4

# Development only: the Vite dev server behind the dev nginx. Production
# compiles the SPA inside docker/nginx-prod.dockerfile instead.
FROM node:20-alpine AS development

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./

RUN npm ci

COPY frontend/ .

EXPOSE 3000

CMD ["npm", "run", "dev"]
